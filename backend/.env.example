# Database. Postgres is supported via e.g.
# DATABASE_URL=postgresql://user:pass@localhost:5432/ultorn
DATABASE_URL=sqlite:///./ultorn.db

# Leave blank to auto-generate and persist a key beside the database.
# Set explicitly in production (e.g. `openssl rand -base64 48`).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI routing. "local" never calls an external provider (rule-based, not a
# model). "ollama" calls a real open-source model running on your own
# machine via https://ollama.com -- no API key, nothing leaves the box.
# `ollama serve` + `ollama pull llama3.2` first.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Scanning
SCANNER_TIMEOUT=300
NUCLEI_PATH=nuclei

# Continuous monitoring scheduler (set false on extra replicas; it only
# decides when work is due and enqueues it onto Celery/Redis below)
ENABLE_SCHEDULER=true

# Queue that scheduled monitor checks and scans are dispatched onto, so
# running several API replicas never duplicates a run. Run a worker with:
#   celery -A app.celery_app worker --loglevel=info
REDIS_URL=redis://localhost:6379/0
# Dev/test only: run Celery tasks inline instead of enqueuing them (no
# Redis or worker process required). pytest sets this itself.
CELERY_TASK_ALWAYS_EAGER=false

# How long a forgot-password token stays valid.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Rate limits on /auth/token and /auth/register. Raise these for a backend
# driving the Playwright E2E suite (frontend/e2e/) -- many logins from one
# IP in a tight window can trip the defaults on volume alone, not abuse.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=300

# Where finding evidence attachments (screenshots, raw scanner output) are
# stored on disk, and the per-file upload cap.
ATTACHMENT_STORAGE_DIR=./attachments
ATTACHMENT_MAX_SIZE_MB=10

# Optional: POST new alerts to Slack/Teams/SIEM.
# If a secret is set, requests carry X-Ultorn-Signature: sha256=<hmac>.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

APP_NAME=Ultorn
DEBUG=True
